# 允许宽容的 peer dep 解析（项目里 eslint v9 与 plugin 的 peer 声明有不一致）
# 写在 .npmrc 里比命令行 --legacy-peer-deps 更稳：
#   1) 本地 / CI 行为统一
#   2) 避免 npm 10 在 CLI flag 路径下偶发的 "Exit handler never called!" bug
legacy-peer-deps=true

# 网络相关：CI 上偶发网络抖动，给更大的超时和重试
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
