# ===== Registry 镜像 =====
# 项目级 registry，覆盖全局配置（你电脑全局是美团内网 r.npm.sankuai.com）
# 用淘宝镜像 npmmirror：
#   - 公网可访问（GitHub Actions runner 也能拉）
#   - 国内访问也快
#   - 与官方 registry 同步
registry=https://registry.npmmirror.com/

# ===== pnpm 配置 =====
auto-install-peers=true
strict-peer-dependencies=false
audit=false
fund=false
shamefully-hoist=true
